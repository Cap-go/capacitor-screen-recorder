{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Cap-go/.github:renovate-config"
  ],
  "packageRules": [
    {
      "description": "Cap-go plugins follow the official Capacitor Android toolchain; never bump Gradle wrapper, AGP, or Kotlin via Renovate",
      "matchManagers": ["gradle-wrapper"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "/^com\\.android\\.tools\\.build:gradle$/",
        "/^com\\.android\\.(library|application)/",
        "/^org\\.jetbrains\\.kotlin[:.]/"
      ],
      "matchManagers": ["gradle"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "eslint"
      ],
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "description": "GitHub Actions major bumps: Renovate opens PRs; renovate-ai-automerge merges after CodeRabbit APPROVED + CI green. Requires repo variable AUTOMERGE_APP_ID and secret AUTOMERGE_APP_PRIVATE_KEY for renovate-ai-automerge-merge.yml.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "github-actions",
        "dependencies"
      ]
    }
  ]
}
